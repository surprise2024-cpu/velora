// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HotelBrand {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches Branch[]
}

model Branch {
  id          String   @id @default(uuid()) @db.Uuid
  brandId     String   @db.Uuid
  name        String
  description String?
  address     String
  city        String
  province    String
  country     String   @default("South Africa")
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images     String[] @default([])
  amenities  String[] @default([])
  policies   String[] @default([])
  starRating Int?

  brand      HotelBrand  @relation(fields: [brandId], references: [id])
  roomTypes  RoomType[]
  rooms      Room[]
  favourites Favourite[]

  @@unique([brandId, name])
  @@index([city])
}

model RoomType {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  name        String
  description String?
  maxGuests   Int
  basePrice   Decimal  @db.Decimal(12, 2)
  currency    String   @default("ZAR")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images    String[] @default([])
  amenities String[] @default([])

  branch Branch @relation(fields: [branchId], references: [id])
  rooms  Room[]

  @@unique([branchId, name])
  @@unique([id, branchId])
  @@index([branchId])
}

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  branchId   String   @db.Uuid
  roomTypeId String   @db.Uuid
  roomNumber String
  floor      Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id])
  roomType RoomType @relation(fields: [roomTypeId, branchId], references: [id, branchId])

  bookingRooms BookingRoom[]

  @@unique([branchId, roomNumber])
  @@index([roomTypeId])
}

model Booking {
  id         String        @id @default(uuid()) @db.Uuid
  checkIn    DateTime      @db.Date
  checkOut   DateTime      @db.Date
  guestCount Int
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  userId     String?       @db.Uuid

  user User? @relation(fields: [userId], references: [id])

  bookingRooms BookingRoom[]
  payments     Payment[]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  name       String?
  provider   String
  providerId String
  role       UserRole @default(CUSTOMER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bookings   Booking[]
  favourites Favourite[]

  @@unique([provider, providerId])
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model BookingRoom {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @db.Uuid
  roomId    String   @db.Uuid
  price     Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])

  @@unique([bookingId, roomId])
  @@index([roomId])
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  bookingId             String        @db.Uuid
  provider              String        @default("PAYSTACK")
  reference             String        @unique
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("ZAR")
  status                PaymentStatus @default(PENDING)
  providerTransactionId String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model Favourite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  branchId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
}
